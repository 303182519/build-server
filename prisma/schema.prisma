// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// User（示例，全部id改为雪花BigInt UNSIGNED）
// ----------------------------------------------------------------------------
model User {
  id        BigInt    @id // ❗不要写@default(autoincrement())，代码层生成雪花ID
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3) // 软删除：null=未删除，有值=删除时间


  email     String?   @unique @db.VarChar(255) // 可空：OAuth 用户（如微信）可能无邮箱；非 NULL 值仍互斥，邮箱注册防重不变
  username  String    @unique @db.VarChar(100)
  password  String?    @db.VarChar(255)
  specialRoles  String?   @db.VarChar(255)

  @@index([deletedAt]) // 软删除查询索引

  // 关联
  roles UserRoles[]     
  refreshTokens RefreshToken[]
  posts Post[]
  identities UserIdentity[] // 第三方登录身份（GitHub / 微信 / ...）

  @@map("users")
}

// ----------------------------------------------------------------------------
// UserIdentity —— 第三方登录身份表（账号 与 第三方身份 解耦）
// ----------------------------------------------------------------------------
// 一个 User 可绑定多家第三方身份（GitHub / 微信公众号 / 微信开放平台 / Google...），
// 也可解绑换绑；新增平台只需加一个 provider 字符串值，零表结构变更。
// 登录语义：where provider + providerUid 命中 → 登录该 userId；未命中 → 注册/绑定。
model UserIdentity {
  id        BigInt   @id // 雪花ID，代码层生成
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  userId      BigInt @map("user_id")
  provider    String @db.VarChar(32) // "github" | "wechat_mp" | "wechat_open" | "wechat_mini" | "google" ...
  providerUid String @map("provider_uid") @db.VarChar(128) // 第三方唯一标识：github 数字id / openid / unionid / sub

  username  String? @db.VarChar(100) // 缓存第三方昵称，避免每次回调都调第三方 API
  avatarUrl String? @map("avatar_url") @db.VarChar(512)
  raw       Json?   // 首次授权时的完整 profile 快照，审计与排障用

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid]) // 一个第三方身份全局只能绑到一个账号
  @@index([userId]) // 反查：某账号绑定了哪些身份
  @@map("user_identities")
}

model Role {
  id          BigInt    @id
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3) // 软删除：null=未删除，有值=删除时间

  name        String
  description String?
  code        String    @unique

  users UserRoles[]     
  rolePermissions RolePermissions[]

  @@map("roles")
}

model Permission {
  id          BigInt    @id
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @db.DateTime(3) // 软删除：null=未删除，有值=删除时间

  name        String    @unique
  code        String    @unique @db.VarChar(255)
  description String?

  rolePermissions RolePermissions[]

  @@map("permissions")
}

// 用户 ↔ 角色 中间表
model UserRoles {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// 角色 ↔ 权限 中间表
model RolePermissions {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")  

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// RefreshToken —— Day 32：可撤销的刷新令牌（呼应 Day 31「JWT access + 可撤销 refresh」）
// ----------------------------------------------------------------------------
// access token 是无状态 JWT（不入库）；refresh token 是不透明随机串，这里**只存它的
// sha256 哈希**——数据库泄露也拿不到可用的 refresh（和"只存密码哈希"同理）。
// 登出 / 轮换时把对应行 revokedAt 置上，即可即时作废。
model RefreshToken {
  id        BigInt    @id
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64) // sha256 hex = 64 字符
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}


// ----------------------------------------------------------------------------
// Post — 雪花ID，多对多标签中间表方案
// ----------------------------------------------------------------------------
model Post {
  id        BigInt    @id
  title     String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(120)
  content   String    @db.Text

  postTags PostTag[]

  status    String    @default("draft") @db.VarChar(20)
  meta      Json?     @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3) 

  version    Int @default(1)
  viewCount  Int @default(0) @map("view_count")

  revisions PostRevision[]

  authorId BigInt? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([authorId])
  @@map("posts")
}

// ----------------------------------------------------------------------------
// PostRevision 文章修订快照
// ----------------------------------------------------------------------------
model PostRevision {
  id        BigInt    @id
  postId    BigInt    @map("post_id")
  version   Int
  title     String    @db.VarChar(200)
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@index([postId, createdAt])
  @@map("post_revisions")
}

// ----------------------------------------------------------------------------
// Tag 标签表
// ----------------------------------------------------------------------------
model Tag {
  id        BigInt    @id
  name      String    @db.VarChar(50) @unique
  postTags  PostTag[]

  @@map("tags")
}

// ----------------------------------------------------------------------------
// PostTag 多对多中间表
// ----------------------------------------------------------------------------
model PostTag {
  postId BigInt @map("post_id")
  tagId  BigInt @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ----------------------------------------------------------------------------
// AgentApproval —— Agent 人工审批记录（agent_approvals）
// ----------------------------------------------------------------------------
// LangGraph human-in-the-loop 的审批域（权威数据源在 MySQL，图状态 checkpoint 在 Redis）：
// 一次 run 对应一条审批记录（threadId 唯一）：
//   发起 run → 建行（status=PENDING, payload=NULL 表示草稿生成中）
//   → Qwen 草稿完成 → 回填 payload → 等待人工
//   → decide 原子流转 APPROVED / REJECTED（decidedAt 落时间）
//   → APPROVED 后 resume 图执行副作用（创建文章草稿），结果落 result / error / executedAt。
// 不建用户外键：审批记录是审计数据，应独立于用户生命周期（与 job_runs.createdBy 同理）。
model AgentApproval {
  id        BigInt    @id // 雪花ID，代码层生成
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  threadId   String   @unique @map("thread_id") @db.VarChar(64) // LangGraph thread_id（雪花字符串）
  userId     BigInt   @map("user_id") // 发起人（唯一有审批权的人）
  prompt     String   @db.VarChar(1000) // 用户原始诉求
  actionType String   @default("create_post_draft") @map("action_type") @db.VarChar(64)
  payload    Json?    @db.Json // 待审批内容（Qwen 生成的文章草稿）；NULL = 草稿生成中/失败
  status     String   @default("PENDING") @db.VarChar(16) // PENDING / APPROVED / REJECTED

  decidedAt  DateTime? @map("decided_at") @db.DateTime(3)
  reason     String?   @db.VarChar(500) // 审批意见（拒绝理由等）
  executedAt DateTime? @map("executed_at") @db.DateTime(3) // 副作用执行完成时间（成功或失败）
  result     Json?     @db.Json // 副作用结果（如 { postId }）
  error      String?   @db.Text // 草稿生成失败 / 副作用执行失败的错误信息

  @@index([userId, status])
  @@map("agent_approvals")
}

// ----------------------------------------------------------------------------
// JobRun —— 任务执行记录（job_runs）
// ----------------------------------------------------------------------------
// 任务中心（前端）与 Bull Board 的分界：job_runs 存业务任务生命周期
// （name/payload/result/errorMessage/triggerType），供业务侧查询与 SSE 推送；
// BullMQ 队列内部状态（waiting/active/...）由 Bull Board 观察，二者数据源不同。
// 触发者不建外键：任务记录是审计数据，应独立于用户生命周期（用户删除不影响历史任务）。
model JobRun {
  id        BigInt    @id // 雪花ID，代码层生成
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3) // 软删除：null=未删除，有值=删除时间

  name        String  @db.VarChar(128) // 任务名（JOB_NAMES）
  queueName   String  @default("default") @map("queue_name") @db.VarChar(64)
  bullJobId   String? @map("bull_job_id") @db.VarChar(128) // BullMQ 内部 job id
  triggerType String  @default("manual") @map("trigger_type") @db.VarChar(32)
  status      String  @default("queued") @db.VarChar(32)

  progress     Int     @default(0)
  payload      Json?   @db.Json // 任务参数
  result       Json?   @db.Json // 任务结果
  errorMessage String? @map("error_message") @db.Text

  attemptsMade Int  @default(0) @map("attempts_made")
  maxAttempts  Int  @default(1) @map("max_attempts")

  startedAt  DateTime? @map("started_at") @db.DateTime(3) // 首次开始执行时间
  finishedAt DateTime? @map("finished_at") @db.DateTime(3) // 终态（completed/failed/cancelled）时间

  createdBy BigInt? @map("created_by") // 触发者用户ID

  @@index([status, createdAt])
  @@index([name, createdAt])
  @@index([bullJobId])
  @@index([deletedAt])

  @@map("job_runs")
}